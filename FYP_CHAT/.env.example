# Copy to ".env" (or run "npm run init-env" to create it from the backend's appsettings.json).
# Put values in double quotes: an unquoted # starts a comment and would cut a secret short.

PORT=4000

# Must be the same values as "Jwt" in FYP_BACKEND/fyp_project/appsettings.json, so the chat server can read the sign-in cookie.
JWT_KEY=
JWT_ISSUER=Hierarchicalfyp_projectAPI
JWT_AUDIENCE=Hierarchicalfyp_projectClient

# The ASP.NET API that saves the messages, and the secret it shares with this server ("Chat:ServiceKey" in appsettings.json).
API_BASE_URL=https://localhost:7259
CHAT_SERVICE_KEY=
# The local ASP.NET development certificate is self-signed.
API_INSECURE_TLS=true

# Only for testing before the organization portal exists: serves /dev (a page where you chat as an organization).
# NEVER switch this on in production.
CHAT_DEV_TOOLS=false
