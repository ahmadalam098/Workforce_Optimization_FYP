# Copy this file to ".env" and adjust values for your machine.

# Base URL for API calls made by the browser.
# Leave empty during development so requests go through the Vite proxy (same origin).
# This is required because the backend stores the JWT in an HttpOnly, SameSite=Strict cookie.
VITE_API_BASE_URL=

# Where the Vite dev server forwards "/api" requests (the ASP.NET Core backend).
VITE_API_PROXY_TARGET=https://localhost:7259

# Where the Vite dev server forwards "/socket.io" (the Node.js chat server in FYP_CHAT).
VITE_CHAT_PROXY_TARGET=http://localhost:4000
