{
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Database=WorkforceManagementDB;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "RedisConnectionStrings": {
    "Redis": "<your-redis-host>:<port>"
  },
  "Redis": {
    "User": "default",
    "Password": "<your-redis-password>"
  },
  "Jwt": {
    "Key": "<a-long-random-secret-at-least-32-characters>",
    "Issuer": "Hierarchicalfyp_projectAPI",
    "Audience": "Hierarchicalfyp_projectClient",
    "ExpiryMinutes": 30
  },
  "EmailSettings": {
    "Host": "smtp.gmail.com",
    "Port": 587,
    "Username": "<your-gmail-address>",
    "Password": "<your-gmail-app-password>",
    "PickupDirectory": ""
  },
  "Chat": {
    "ServiceKey": "<a-long-random-secret-shared-with-the-chat-server-in-FYP_CHAT/.env>"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Ai": {
    "PlannerUrl": "",
    "ServiceKey": "",
    "RecallMinutes": 3,
    "OfferMinutes": 10,
    "TickSeconds": 15
  },
  "Payments": {
    "Gateway": "Demo"
  },
  "Safepay": {
    "Environment": "sandbox",
    "PublicKey": "<Safepay public key: sec_...>",
    "SecretKey": "<Safepay secret key>",
    "WebhookSecret": "<optional: webhook shared secret from Developer > Endpoints>",
    "ReturnBaseUrl": "http://localhost:5173"
  }
}
